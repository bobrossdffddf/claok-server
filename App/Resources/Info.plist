	<array>
		<string>localdevvpn</string>
		<string>shortcuts</string>
		<string>protonvpn</string>
		<string>nordvpn</string>
		<string>mullvad</string>
		<string>expressvpn</string>
		<string>surfshark</string>
		<string>windscribe</string>
		<string>cyberghost</string>
		<string>piavpn</string>
		<string>ipvanish</string>
		<string>hotspotshield</string>
		<string>tunnelbear</string>
		<string>nortonvpn</string>
		<string>ivpn</string>
		<string>openvpn</string>
		<string>wireguard</string>
		<string>tailscale</string>
		<string>App-prefs</string>
		<string>life360</string>
		<string>findmy</string>
		<string>com.nianticlabs.pokemongo</string>
		<string>tinder</string>
		<string>hinge</string>
		<string>bumble</string>
		<string>grindr</string>
		<string>snapchat</string>
		<string>uber</string>
		<string>lyft</string>
		<string>doordash</string>
		<string>strava</string>
		<string>venmo</string>
		<string>cashapp</string>
		<string>paypal</string>
		<string>nflx</string>
		<string>disneyplus</string>
		<string>hulu</string>
		<string>instagram</string>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSBonjourServices</key>
	<array>
		<string>_remotepairing._tcp</string>
		<string>_remotepairing-pairable-host._tcp</string>
		<string>_remoted._tcp</string>
		<string>_apple-mobdev2._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Cloak uses the camera once, to scan the pairing code shown by the helper on your computer.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Cloak talks to this phone's own developer services over a loopback connection. Nothing leaves the device.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Cloak reads your position in the background so the geofence guard can stop simulation if you leave the area you set.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Cloak reads your position so it can show you where you actually are and run the geofence guard.</string>
	<key>NSMotionUsageDescription</key>
	<string>Cloak watches for real movement so it can tell when your actual position may have changed.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>app.cloak.renew</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
