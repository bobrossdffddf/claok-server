# Copy to .env and fill these in.

# Your GitHub username, lowercase, in the image name.
CLOAK_IMAGE=ghcr.io/your-github-username/cloak-server:latest

# Anyone with this can create licences. Make it with:  openssl rand -hex 32
CLOAK_ADMIN_TOKEN=

# From the Cloudflare dashboard, Zero Trust, Networks, Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=
